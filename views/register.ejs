<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account · Expense Tracker</title>
    <!-- Prevent theme flicker on page load -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('theme');
                if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo-group">
            <a href="/login" class="logo">
                <div class="logo-icon">₹</div>
                <span>Expense Tracker</span>
            </a>
        </div>
        <p class="nav-subtitle">Manage your money wisely</p>
        <div class="nav-actions">
            <a href="/login" class="nav-btn nav-btn-primary">Sign In</a>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container auth-wrapper">
        <div class="auth-split-container">
            <!-- LEFT HERO / ANIMATED SHOWCASE -->
            <div class="auth-hero-showcase">
                <div class="auth-hero-badge">
                    <span>✨</span> Smart Personal Finance
                </div>
                <h2 class="auth-hero-title">
                    Take Full Control of Your <span>Money & Spending</span>
                </h2>
                <p class="auth-hero-desc">
                    Track daily expenses, set monthly category budgets, analyze visual charts, and grow your savings effortlessly.
                </p>

                <div class="auth-floating-cards">
                    <div class="floating-preview-card floating-card-1">
                        <div class="floating-card-icon">📊</div>
                        <div class="floating-card-info">
                            <h4>Visual Spending Analytics</h4>
                            <p>Real-time monthly charts & category breakdown</p>
                        </div>
                        <div class="floating-card-amount">Live</div>
                    </div>

                    <div class="floating-preview-card floating-card-2">
                        <div class="floating-card-icon">🎯</div>
                        <div class="floating-card-info">
                            <h4>Smart Budget Thresholds</h4>
                            <p>Get instant alerts when near category limits</p>
                        </div>
                        <div class="floating-card-amount">₹ Limit</div>
                    </div>
                </div>
            </div>

            <!-- RIGHT REGISTRATION FORM CARD -->
            <div class="auth-card">
                <div class="auth-header">
                    <div class="auth-logo">₹</div>
                    <h1>Create Account</h1>
                    <p>Start tracking your expenses and mastering your budget</p>
                </div>

                <!-- ALERTS -->
                <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                    <div class="alert alert-error" style="margin-bottom: 16px;">
                        <span><%= error_msg %></span>
                    </div>
                <% } %>

                <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                    <div class="alert alert-success" style="margin-bottom: 16px;">
                        <span><%= success_msg %></span>
                    </div>
                <% } %>

                <!-- REGISTRATION FORM -->
                <form id="register-form" action="/register" method="POST">
                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            value="<%= typeof name !== 'undefined' ? name : '' %>"
                            placeholder="e.g. Jasmine Sayyed"
                            required
                            autocomplete="name"
                            autofocus
                        >
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                            placeholder="you@example.com"
                            required
                            autocomplete="email"
                        >
                    </div>

                    <div class="form-group">
                        <label for="password">Set Password (min 6 characters)</label>
                        <div class="password-input-wrapper">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Create a secure password"
                                required
                                minlength="6"
                                autocomplete="new-password"
                            >
                            <button
                                type="button"
                                class="password-toggle-btn"
                                onclick="togglePasswordVisibility('password', this)"
                                title="Toggle password view"
                            >👁️</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="confirm_password">Confirm Password</label>
                        <div class="password-input-wrapper">
                            <input
                                type="password"
                                id="confirm_password"
                                name="confirm_password"
                                placeholder="Repeat your password"
                                required
                                minlength="6"
                                autocomplete="new-password"
                            >
                            <button
                                type="button"
                                class="password-toggle-btn"
                                onclick="togglePasswordVisibility('confirm_password', this)"
                                title="Toggle password view"
                            >👁️</button>
                        </div>
                        <small style="font-size: 11.5px; color: var(--muted); margin-top: 5px; display: block;">
                            An OTP code will be sent to verify your email.
                        </small>
                    </div>

                    <button type="submit" class="btn-primary" style="margin-top: 10px;">
                        Create Account →
                    </button>
                </form>

                <div class="auth-footer">
                    <p>Already have an account? <a href="/login">Sign In</a></p>
                </div>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer>
        <p>Expense Tracker · Smart Personal Finance Management</p>
    </footer>

    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁️';
            }
        }
    </script>
</body>
</html>
