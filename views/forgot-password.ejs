<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot / Reset Password · Expense Tracker</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo-group">
            <a href="/login" class="logo">
                <div class="logo-icon">₹</div>
                <span>Expense Tracker</span>
            </a>
        </div>
        <p class="nav-subtitle">Manage your money wisely</p>
        <div class="nav-actions">
            <a href="/login" class="nav-btn nav-btn-outline">Sign In</a>
            <a href="/register" class="nav-btn nav-btn-primary">Create Account</a>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container auth-wrapper">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">🔑</div>
                <h1>Reset Password</h1>
                <p>Enter your email to receive a 6-digit OTP code to reset your password</p>
            </div>

            <!-- ALERTS -->
            <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="alert alert-error" style="margin-bottom: 16px;">
                    <span><%= error_msg %></span>
                </div>
            <% } %>

            <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="alert alert-success" style="margin-bottom: 16px;">
                    <span><%= success_msg %></span>
                </div>
            <% } %>

            <!-- FORGOT PASSWORD FORM -->
            <form action="/forgot-password" method="POST">
                <div class="form-group">
                    <label for="email">Your Registered Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= typeof email !== 'undefined' ? email : '' %>"
                        placeholder="you@example.com"
                        required
                        autocomplete="email"
                    >
                </div>

                <button type="submit" class="btn-primary" style="margin-top: 10px;">
                    Send 6-Digit OTP Code →
                </button>
            </form>

            <div class="auth-footer" style="margin-top: 24px;">
                <p>Remember your password? <a href="/login">Sign In</a></p>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer>
        <p>Expense Tracker · Smart Personal Finance Management</p>
    </footer>

</body>
</html>
