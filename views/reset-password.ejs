<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New Password · Expense Tracker</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo-group">
            <a href="/login" class="logo">
                <div class="logo-icon">₹</div>
                <span>Expense Tracker</span>
            </a>
        </div>
        <p class="nav-subtitle">Manage your money wisely</p>
        <div class="nav-actions">
            <a href="/login" class="nav-btn nav-btn-outline">Sign In</a>
            <a href="/register" class="nav-btn nav-btn-primary">Create Account</a>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container auth-wrapper">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">🔒</div>
                <h1>Set New Password</h1>
                <p>Enter the 6-digit verification code sent to <strong><%= typeof email !== 'undefined' ? email : '' %></strong> and your new password.</p>
            </div>

            <!-- DEV OTP BANNER -->
            <% if (typeof dev_otp_preview !== 'undefined' && dev_otp_preview) { %>
                <div class="alert alert-dev" style="margin-bottom: 16px;">
                    <div>
                        <strong>Demo / Dev OTP Code:</strong>
                        <span class="otp-code-highlight"><%= dev_otp_preview %></span>
                    </div>
                </div>
            <% } %>

            <!-- ALERTS -->
            <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="alert alert-error" style="margin-bottom: 16px;">
                    <span><%= error_msg %></span>
                </div>
            <% } %>

            <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="alert alert-success" style="margin-bottom: 16px;">
                    <span><%= success_msg %></span>
                </div>
            <% } %>

            <!-- RESET PASSWORD FORM -->
            <form action="/reset-password" method="POST">
                <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">

                <div class="form-group">
                    <label for="otp">6-Digit Verification Code</label>
                    <input
                        type="text"
                        id="otp"
                        name="otp"
                        placeholder="••••••"
                        maxlength="6"
                        required
                        autocomplete="one-time-code"
                        style="text-align: center; font-size: 20px; font-weight: 700; letter-spacing: 4px;"
                    >
                </div>

                <div class="form-group">
                    <label for="password">New Password</label>
                    <div class="password-input-wrapper">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Min 6 characters (your choice)"
                            required
                            minlength="6"
                            autocomplete="new-password"
                        >
                        <button
                            type="button"
                            class="password-toggle-btn"
                            onclick="togglePasswordVisibility('password', this)"
                            aria-label="Toggle password visibility"
                        >
                            👁️
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirm_password">Confirm New Password</label>
                    <div class="password-input-wrapper">
                        <input
                            type="password"
                            id="confirm_password"
                            name="confirm_password"
                            placeholder="Re-enter new password"
                            required
                            minlength="6"
                            autocomplete="new-password"
                        >
                        <button
                            type="button"
                            class="password-toggle-btn"
                            onclick="togglePasswordVisibility('confirm_password', this)"
                            aria-label="Toggle confirm password visibility"
                        >
                            👁️
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-primary" style="margin-top: 10px;">
                    Update Password & Sign In →
                </button>
            </form>

            <div class="auth-footer" style="margin-top: 24px;">
                <p>Remembered? <a href="/login">Back to Sign In</a></p>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer>
        <p>Expense Tracker · Smart Personal Finance Management</p>
    </footer>

    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🔒';
            } else {
                input.type = 'password';
                btn.textContent = '👁️';
            }
        }
    </script>

</body>
</html>
